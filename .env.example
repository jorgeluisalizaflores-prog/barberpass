# ── Base de datos ─────────────────────────────────────────────────────────
# Rol de la APLICACIÓN (sin privilegios para saltarse Row Level Security).
DATABASE_URL="postgresql://barberpass_app:CAMBIA_ESTA_CLAVE@localhost:5432/barberpass"
# Rol DUEÑO de las tablas: solo lo usan las migraciones (prisma migrate).
DIRECT_URL="postgresql://barberpass_owner:CAMBIA_ESTA_CLAVE@localhost:5432/barberpass"

# ── Plataforma ────────────────────────────────────────────────────────────
# Nombre comercial que se muestra en toda la plataforma.
NEXT_PUBLIC_PLATFORM_NAME="BarberPass"
# URL pública (sin barra final). Se usa en los QR y en los enlaces de WhatsApp.
APP_URL="http://localhost:3000"

# ── Opcionales ────────────────────────────────────────────────────────────
# Secreto extra que se mezcla en los hashes de contraseñas y PINs. Defínelo ANTES
# de crear usuarios y no lo cambies después (invalidaría todas las claves).
# AUTH_PEPPER=""
# Correos de recuperación de contraseña con Resend (https://resend.com).
# RESEND_API_KEY=""
# EMAIL_FROM="BarberPass <no-responder@tudominio.pe>"
# WhatsApp de contacto inicial (luego se edita en /admin/configuracion).
# CONTACT_WHATSAPP="987654321"
# Contraseña del dueño de la barbería demo (npm run demo).
# DEMO_PASSWORD=""
# FASE 2: dominio raíz para subdominios por barbería (ver README).
# ROOT_DOMAIN="barberpass.pe"
